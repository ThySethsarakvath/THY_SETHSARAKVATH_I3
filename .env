# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=order_worker

# JWT (Auth Service)
JWT_SECRET=super-secret-demo
JWT_EXPIRES_IN=1h
JWT_ACCESS_SECRET=Some_Random_String
JWT_REFRESH_SECRET=Another_Random_String
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Service URLs (for Gateway)
AUTH_SERVICE_URL=http://auth-service:3000
ORDER_SERVICE_URL=http://order-worker:3000
GATEWAY_PORT=3000

# Service Ports
AUTH_PORT=3000
ORDER_PORT=3000

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672